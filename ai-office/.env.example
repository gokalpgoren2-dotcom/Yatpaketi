# Yatpaketi AI Office ortam değişkenleri. Gerçek değerleri ai-office/.env.local dosyasına yazın; depoya yüklemeyin.
# Hiçbiri NEXT_PUBLIC_ ile başlamaz: tümü yalnızca sunucuda okunur, tarayıcıya gönderilmez.

# --- Erişim ---
# Ofise giriş parolası. Boş bırakılırsa ofis yalnızca localhost üzerinden açılır.
AI_OFFICE_PASSWORD=
# Oturum çerezini imzalayan gizli değer (en az 32 karakter). Üretmek için: openssl rand -hex 32
AI_OFFICE_SESSION_SECRET=

# --- Ajan yürütme ---
# Boşsa ofis YEREL MOD'da çalışır: LLM yok, ajanlar depo üzerinde sabit denetimler çalıştırır.
# Doluysa GERÇEK MOD: görevler Claude Agent SDK ile yürütülür ve API kullanımı faturalanır.
ANTHROPIC_API_KEY=
# Kullanılacak model.
AI_OFFICE_MODEL=claude-opus-5-5
# Tek görev için harcama tavanı (USD, tahmini) ve tur sınırı.
AI_OFFICE_MAX_BUDGET_USD=2
AI_OFFICE_MAX_TURNS=40
# Aynı anda yürüyen görev sayısı.
AI_OFFICE_CONCURRENCY=2

# --- Yollar ---
# Ajanların çalıştığı depo kökü. Varsayılan: ai-office klasörünün bir üstü.
AI_OFFICE_WORKSPACE=
# SQLite veritabanının yazıldığı klasör. Varsayılan: ai-office/data
AI_OFFICE_DATA_DIR=

# --- Meta (isteğe bağlı, salt okunur) ---
# meta-agent'ın gerçek reklam performansı okuması için. Yalnızca ads_read izni olan bir token kullanın.
META_ACCESS_TOKEN=
# Reklam hesabı kimliği, "act_" ön eki olmadan.
META_AD_ACCOUNT_ID=
META_GRAPH_VERSION=v21.0
