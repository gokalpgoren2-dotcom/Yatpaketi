{
  "appId": "com.yatpaketi.app",
  "appName": "Yatpaketi",
  "webDir": "www",
  "backgroundColor": "#06264B",
  "appendUserAgent": "YatpaketiApp",
  "server": {
    "allowNavigation": [
      "yatpaketi.com",
      "www.yatpaketi.com"
    ],
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#06264B",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#06264B"
    }
  }
}
